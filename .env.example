# Optional: override the local database. SQLite is used by default.
# DATABASE_URL=sqlite:///tankradar.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/tankradar

# Optional: source CSV for GitHub/cloud import.
# GITHUB_CSV_URL=https://raw.githubusercontent.com/<owner>/<repo>/main/prices_history.csv

# Optional: how to read cloud CSV timestamps that carry no UTC offset. The GitHub
# workflow runs in UTC, so "utc" (the default) converts them to local time on
# import. Use "local" to import them verbatim.
# TANKRADAR_CLOUD_CSV_NAIVE_TZ=utc

# Optional: write/read a different local CSV file for cloud_scraper.py.
# TANKRADAR_CSV=prices_history.csv

# Optional: scraper defaults.
# TANKRADAR_PLZ=35444
# TANKRADAR_DISTANCE=10
# TANKRADAR_SCRAPE_INTERVAL_MINUTES=15

# Optional: dashboard runtime.
# Set the host to 0.0.0.0 to reach the dashboard from a phone on the same network
# (see the "Android" section in README.md). This exposes it unencrypted and
# without a login to everyone on that network, so only do it on a trusted one.
# TANKRADAR_DASH_HOST=127.0.0.1
# TANKRADAR_DASH_PORT=8050
# TANKRADAR_DASH_DEBUG=false

# Optional: native desktop window (pywebview) instead of opening in the browser.
# TANKRADAR_NATIVE_WINDOW=true
# TANKRADAR_WINDOW_TITLE=TankRadar
# TANKRADAR_WINDOW_WIDTH=1400
# TANKRADAR_WINDOW_HEIGHT=900
